{
    "name": "kingbes/annotation",
    "type": "library",
    "license": "MIT",
    "description": "Thinkphp plugin kingbes/annotation",
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Kingbes\\Annotation\\": "src"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Kingbes\\Annotation\\Service"
            ],
            "config": {
                "annotation": "src/config.php"
            }
        }
    }
}